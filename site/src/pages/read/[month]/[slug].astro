---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getArticles } from "../../../lib/content.js";

export function getStaticPaths() {
  return getArticles().map((article) => ({
    params: {
      month: article.month,
      slug: article.slug,
    },
    props: {
      article,
    },
  }));
}

const { article } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
  description={article.subtitle || article.title}
  title={`${article.title} · Essays`}
>
  <main class="reader-shell">
    <nav class="reader-nav" aria-label="Navigation">
      <a href={base}>Essays</a>
      <span>/</span>
      <span>{article.monthLabel}</span>
    </nav>

    <article>
      <header class="article-header">
        <p class="eyebrow">{article.monthLabel}</p>
        <h1>{article.title}</h1>
        {article.subtitle && <p class="article-lead">{article.subtitle}</p>}
        <div class="meta-row">
          <span>
            {article.lastUpdated
              ? article.lastUpdated
              : `Archived ${article.monthLabel}`}
          </span>
          <a href={`${base}${article.sourcePath.replace(/^\//, "")}`}>
            Markdown source
          </a>
        </div>
      </header>

      <div class="prose" set:html={article.html} />

      <footer class="author-note" aria-label="关于作者">
        <p><strong>关于作者 · 林观果 / Lin Guanguo</strong></p>
        <p>
          我在上海从事 Agent Runtime 与后端系统研发，关注智能体运行时、工具设计、记忆与上下文，以及生产系统的可靠性。
        </p>
        <p>
          <a href={`${base}about/`}>关于我</a>
          <span aria-hidden="true"> · </span>
          <a href="mailto:lin.guanguo2000@gmail.com">交流与联系</a>
        </p>
      </footer>
    </article>
  </main>
</BaseLayout>
