---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getArticles } from "../../../lib/content.js";

export function getStaticPaths() {
  return getArticles().map((article) => ({
    params: {
      month: article.month,
      slug: article.slug,
    },
    props: {
      article,
    },
  }));
}

const { article } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
  description={article.subtitle || article.title}
  title={`${article.title} · Essays`}
>
  <main class="reader-shell">
    <nav class="reader-nav" aria-label="Navigation">
      <a href={base}>Essays</a>
      <span>/</span>
      <span>{article.monthLabel}</span>
    </nav>

    <article>
      <header class="article-header">
        <p class="eyebrow">{article.monthLabel}</p>
        <h1>{article.title}</h1>
        {article.subtitle && <p class="article-lead">{article.subtitle}</p>}
        <div class="meta-row">
          <span>
            {article.lastUpdated
              ? article.lastUpdated
              : `Archived ${article.monthLabel}`}
          </span>
          <a href={`${base}${article.sourcePath.replace(/^\//, "")}`}>
            Markdown source
          </a>
        </div>
      </header>

      <div class="prose" set:html={article.html} />
    </article>
  </main>
</BaseLayout>
