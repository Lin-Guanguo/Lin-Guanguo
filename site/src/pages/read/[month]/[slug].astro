---
import "../../../styles/global.css";
import { getArticles } from "../../../lib/content.js";

export function getStaticPaths() {
  return getArticles().map((article) => ({
    params: {
      month: article.month,
      slug: article.slug,
    },
    props: {
      article,
    },
  }));
}

const { article } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={article.subtitle || article.title} />
    <title>{article.title} · Essays</title>
  </head>
  <body>
    <main class="reader-shell">
      <nav class="reader-nav" aria-label="Navigation">
        <a href={base}>Essays</a>
        <span>/</span>
        <span>{article.monthLabel}</span>
      </nav>

      <article>
        <header class="article-header">
          <p class="eyebrow">{article.monthLabel}</p>
          <h1>{article.title}</h1>
          {article.subtitle && <p class="article-lead">{article.subtitle}</p>}
          <div class="meta-row">
            <span>
              {article.lastUpdated
                ? article.lastUpdated
                : `Archived ${article.monthLabel}`}
            </span>
            <a href={`${base}${article.sourcePath.replace(/^\//, "")}`}>
              Markdown source
            </a>
          </div>
        </header>

        <div class="prose" set:html={article.html} />
      </article>
    </main>
  </body>
</html>
