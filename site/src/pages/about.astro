---
import "../styles/global.css";
import Favicon from "../components/Favicon.astro";
import { getAboutPage } from "../lib/content.js";

const about = getAboutPage();
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Public About Me profile for Lin Guanguo."
    />
    <Favicon />
    <title>About · Lin Guanguo</title>
  </head>
  <body>
    <main class="reader-shell">
      <nav class="reader-nav" aria-label="Breadcrumb">
        <a href={base}>Home</a>
        <span>/</span>
        <span>About</span>
      </nav>

      <article>
        <header class="article-header">
          <p class="eyebrow">About Me</p>
          <h1>{about.title}</h1>
          <p class="article-lead">AI Agent / Backend Systems Engineer</p>
          {
            about.lastUpdated && (
              <div class="meta-row">
                <span>Last updated {about.lastUpdated}</span>
              </div>
            )
          }
        </header>

        <div class="prose" set:html={about.html} />
      </article>
    </main>
  </body>
</html>
