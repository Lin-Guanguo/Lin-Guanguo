---
import "../styles/global.css";

interface Props {
  description: string;
  title: string;
}

const { description, title } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <!-- Cloudflare Web Analytics --><script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "8fb2bd9bf84c4eb2a002497861faf5ea"}'></script><!-- End Cloudflare Web Analytics -->
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
