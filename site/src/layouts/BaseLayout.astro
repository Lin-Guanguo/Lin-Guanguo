---
import { getDeploymentConfig } from "../config/deployment.js";
import "../styles/global.css";

interface Props {
  description: string;
  title: string;
}

const { description, title } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const deployment = getDeploymentConfig();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    {
      deployment.cloudflareAnalyticsToken && (
        <script
          is:inline
          type="module"
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({
            token: deployment.cloudflareAnalyticsToken,
          })}
        />
      )
    }
    <title>{title}</title>
  </head>
  <body>
    <slot />
    {
      deployment.icpFiling && (
        <footer class="site-footer">
          <a href={deployment.icpFiling.url} target="_blank" rel="noreferrer">
            {deployment.icpFiling.number}
          </a>
        </footer>
      )
    }
  </body>
</html>
